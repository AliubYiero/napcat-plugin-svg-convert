{
  "name": "napcat-plugin-svg-render",
  "plugin": "SVG渲染器",
  "version": "1.0.0",
  "type": "module",
  "main": "index.mjs",
  "description": "NapCat SVG 渲染插件 - 将 SVG 转换为 PNG 图片",
  "author": "Yiero",
  "license": "MIT",
  "keywords": [
    "napcat",
    "plugin",
    "svg",
    "render",
    "png",
    "image"
  ],
  "napcat": {
    "tags": [
      "工具",
      "图片"
    ],
    "minVersion": "4.14.0",
    "homepage": ""
  },
  "dependencies": {
    "napcat-types": "0.0.16"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.33",
    "napcat-plugin-debug-cli": "^1.2.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "ws": "^8.19.0"
  },
  "scripts": {
    "build": "vite build",
    "build:webui": "cd src/webui && pnpm install && pnpm run build",
    "dev:webui": "cd src/webui && pnpm run dev",
    "watch": "vite build --watch",
    "dev": "vite build --watch",
    "push": "vite build",
    "deploy": "vite build",
    "typecheck": "tsc --noEmit"
  }
}
